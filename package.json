{
  "name": "turbo-morph-3d",
  "version": "0.1.0",
  "private": true,
  "description": "Turbo Morph 3D - Cross-Platform Arcade Supercar Runner (Android & iOS)",
  "scripts": {
    "mobile:init": "npx cap add android && npx cap add ios && npx cap sync",
    "mobile:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "android:build": "cd android && ./gradlew bundleRelease",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0"
  }
}
